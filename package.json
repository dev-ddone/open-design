{
  "name": "@ddone/open-design",
  "version": "2.2.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -n ui,api -c cyan,green \"vite\" \"tsx watch src/server/dev.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/dev.ts",
    "build": "vite build",
    "start": "tsx src/server/dev.ts",
    "db:migrate": "tsx src/server/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@hono/node-server": "^2.0.11",
    "@tailwindcss/vite": "^4.2.2",
    "bcryptjs": "^3.0.3",
    "fabric": "^6.0.0",
    "hono": "^4.12.10",
    "jose": "^6.2.3",
    "jspdf": "^3.0.3",
    "lib0": "^0.2.58",
    "lucide-preact": "^0.575.0",
    "nodemailer": "^7.0.5",
    "pg": "^8.22.0",
    "preact": "^10.25.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.2.2",
    "webfontloader": "^1.6.28",
    "ws": "^8.18.3",
    "y-protocols": "^1.0.5",
    "y-websocket": "2.1.0",
    "yjs": "^13.6.27",
    "yjs-server": "0.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/webfontloader": "^1.6.38",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "react": "npm:@preact/compat@^10.25.0",
      "react-dom": "npm:@preact/compat@^10.25.0"
    }
  }
}
