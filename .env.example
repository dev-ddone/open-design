NODE_ENV=development
PORT=3006
APP_URL=http://localhost:3006
DATABASE_URL=postgresql://open_design:open_design@localhost:5432/open_design
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=ddone_design_session
SESSION_TTL_DAYS=14
REGISTRATION_ENABLED=true

# Storage: local or s3
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=open-design
S3_ACCESS_KEY=open-design
S3_SECRET_KEY=replace-me
S3_FORCE_PATH_STYLE=true

# Optional Iconify upstream proxy
ICONIFY_API_URL=https://api.iconify.design
ICONIFY_COLLECTIONS=tabler,ph,heroicons,bi,material-symbols

# First-run account. Used only when the database has no users.
BOOTSTRAP_ADMIN_EMAIL=admin@ddone.it
BOOTSTRAP_ADMIN_PASSWORD=replace-me-now
BOOTSTRAP_ADMIN_NAME=DDone Admin
BOOTSTRAP_ORGANIZATION_NAME=DDone
