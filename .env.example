NODE_ENV=development
PORT=3006
APP_URL=http://localhost:3006
DATABASE_URL=postgresql://open_design:open_design@localhost:5432/open_design
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=ddone_design_session
SESSION_TTL_DAYS=14
REGISTRATION_ENABLED=true

# Email delivery: smtp sends real messages; log prints one-time links to server logs.
EMAIL_DELIVERY=log
EMAIL_FROM=DDone Design <noreply@ddone.it>
EMAIL_REPLY_TO=info@ddone.it
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_HOURS=72

# Storage: local or s3
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=open-design
S3_ACCESS_KEY=open-design
S3_SECRET_KEY=replace-me
S3_FORCE_PATH_STYLE=true

# Federated Elements universe
ICONIFY_API_URL=https://api.iconify.design
ICONIFY_COLLECTIONS=tabler,ph,heroicons,bi,material-symbols
ELEMENTS_PROVIDERS=builtin,uploads,iconify,openverse,wikimedia
ELEMENTS_CACHE_TTL_SECONDS=900
ELEMENTS_REQUEST_TIMEOUT_MS=8000
ELEMENTS_MAX_PER_PROVIDER=48
OPENVERSE_API_URL=https://api.openverse.org
# Recommended: permanent application credentials. The backend requests and
# renews short-lived access tokens automatically; configure both or neither.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Optional legacy/manual token fallback. Normally leave empty when using the
# client credentials above. Public anonymous search also works with all empty.
OPENVERSE_API_TOKEN=
OPENVERSE_LICENSES=cc0,pdm,by,by-sa
WIKIMEDIA_API_URL=https://commons.wikimedia.org/w/api.php
# Optional comma-separated HTTPS manifests managed by the administrator.
# Add "manifest" to ELEMENTS_PROVIDERS when enabling these packs.
ELEMENT_PACK_URLS=

# First-run account. Used only when the database has no users.
BOOTSTRAP_ADMIN_EMAIL=admin@ddone.it
BOOTSTRAP_ADMIN_PASSWORD=replace-me-now
BOOTSTRAP_ADMIN_NAME=DDone Admin
BOOTSTRAP_ORGANIZATION_NAME=DDone
